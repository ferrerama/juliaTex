% juliatex: run Julia from a LaTeX document (LuaLaTeX + -shell-escape)
%
%   \begin{juliacode} ... \end{juliacode}   shows the code and its output below it
%   \begin{juliarun}  ... \end{juliarun}    only runs it (prepare data, savefig, ...)
%   \juliav{expr}                           inserts the value of expr in the text
%   \juliagraphics[options]{file.pdf}       a figure that Julia saved with savefig
%
%   \usepackage[md]{juliatex}               also writes <document>.md (needs pandoc)
%
% All code shares one Julia session, in document order.
% It runs in the environment of the nearest Project.toml (or $JULIATEX_PROJECT), never
% the global one. Outputs are stored in .juliatex/<document>/; if the code did not change,
% Julia does not run again. A background Julia server (juliatex_server.jl, shuts down
% after 30 min idle) keeps the session and packages loaded: if block k changes, only
% blocks k onwards run. Without the server, everything runs again.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{juliatex}[2026/10/11 Julia in LaTeX]

\newif\ifjuliatex@md
\DeclareOption{md}{\juliatex@mdtrue}
\ProcessOptions\relax

\RequirePackage{iftex}
\RequireLuaTeX
\RequirePackage{xcolor}
\RequirePackage{listings}
\RequirePackage{graphicx}

% juliatex.lua is found like the .sty (TEXINPUTS), so the juliatex/ folder is enough
\directlua{dofile(kpse.find_file("juliatex.lua", "tex"))}
\ifjuliatex@md\directlua{juliatex.md = true}\fi

% --- Appearance -----------------------------------------------------------
\definecolor{juliatex@bg}{HTML}{F4F5F7}
\definecolor{juliatex@keyword}{HTML}{9558B2} % Julia purple
\definecolor{juliatex@string}{HTML}{389826}  % Julia green
\definecolor{juliatex@comment}{HTML}{7A7F87}
\definecolor{juliatex@output}{HTML}{4063D8}  % Julia blue
\definecolor{juliatex@error}{HTML}{CB3C33}   % Julia red

\lstdefinelanguage{Julia}{
  morekeywords={abstract,baremodule,begin,break,catch,const,continue,do,else,
    elseif,end,export,false,finally,for,function,global,if,import,in,isa,let,
    local,macro,module,mutable,nothing,missing,primitive,quote,return,struct,
    true,try,type,using,where,while},
  sensitive=true,
  morecomment=[l]\#,
  morecomment=[n]{\#=}{=\#},
  morestring=[b]",
  morestring=[d]{"""},
}

\lstdefinestyle{juliatex@code}{
  language=Julia,
  basicstyle=\ttfamily\small,
  keywordstyle=\color{juliatex@keyword}\bfseries,
  stringstyle=\color{juliatex@string},
  commentstyle=\color{juliatex@comment}\itshape,
  backgroundcolor=\color{juliatex@bg},
  frame=single, rulecolor=\color{juliatex@bg},
  framesep=4pt, xleftmargin=4pt, xrightmargin=4pt,
  columns=fullflexible, keepspaces=true, showstringspaces=false,
  breaklines=true, upquote=true, extendedchars=true,
  aboveskip=\medskipamount, belowskip=0pt,
}
\lstdefinestyle{juliatex@output}{
  basicstyle=\ttfamily\small\color{juliatex@output},
  frame=leftline, rulecolor=\color{juliatex@output}, framerule=1.2pt,
  xleftmargin=8pt, framesep=6pt,
  columns=fullflexible, keepspaces=true, breaklines=true, extendedchars=true,
  aboveskip=4pt, belowskip=\medskipamount,
}
\lstdefinestyle{juliatex@error}{
  style=juliatex@output,
  basicstyle=\ttfamily\small\color{juliatex@error},
  rulecolor=\color{juliatex@error},
}

\newcommand\JuliatexCode[1]{\lstinputlisting[style=juliatex@code]{#1}}
\newcommand\JuliatexOutput[2]{\lstinputlisting[style=juliatex@#2]{#1}}
% Output not computed yet (first pass): like an undefined reference
\newcommand\JuliatexPending{\textbf{??}}

% --- Environments and commands --------------------------------------------
% Lua takes the raw lines up to \end{...}: the code reaches Julia untouched
\newenvironment{juliacode}
  {\directlua{juliatex.capture("juliacode")}}
  {\directlua{juliatex.close("juliacode")}}
\newenvironment{juliarun}
  {\directlua{juliatex.capture("juliarun")}}
  {\directlua{juliatex.close("juliarun")}}
\newcommand\juliav[1]{%
  \directlua{juliatex.value("\luaescapestring{\detokenize{#1}}")}}

% Figure saved by Julia (savefig): a copy in .juliatex/ is included so that Julia can
% regenerate it while LuaTeX is still writing the PDF; on the first pass it does not exist
\newcommand\juliagraphics[2][]{%
  \directlua{juliatex.graphics("\luaescapestring{#2}", "\luaescapestring{\detokenize{#1}}")}}
\newcommand\JuliatexNoFigure[1]{%
  \fbox{\parbox[c][3cm][c]{0.5\linewidth}{\centering\JuliatexPending\\
    \footnotesize\texttt{#1} (Julia creates it when compiling)}}}

\AtEndDocument{\directlua{juliatex.run()}}
