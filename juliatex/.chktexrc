# juliatex: Julia code is not LaTeX text. nvim/init.lua points CHKTEXRC here (chktex reads "chktexrc" on Windows, ".chktexrc" on Linux)
VerbEnvir
{
    verbatim comment listing verbatimtab rawhtml errexam picture texdraw
    filecontents pgfpicture tikzpicture minted lstlisting IPA
    juliacode juliarun
}

WipeArg
{
    \label:{} \ref:{} \eqref:{} \vref:{} \pageref:{} \index:[]{}
    \cite:[][]{} \nocite:{}
    \juliav:{}
}
